    "dependencies": {
      "python": ">=3.10",
      "required_packages": [
        "click>=8.0.0",
        "pydantic>=2.0.0",
        "toml>=0.10.2",
        "pyyaml>=6.0",
        "rich>=13.0.0"
      ],
      "optional_packages": [
        "sentence-transformers",
        "numpy"
      ]
    },
    "installation": {
      "marketplace": {
        "add": "/plugin marketplace add scooterlacroix/maestro",
        "install": "/plugin install maestro"
      },
      "manual": {
        "url": "https://raw.githubusercontent.com/scooter-lacroix/Maestro/master/install-claude-code.sh",
        "command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/master/install-claude-code.sh | bash"
      }
    },
    "configuration": {
      "global_config_path": "~/.claude/maestro.local.md",
      "project_config_path": ".maestro/config.yaml",
      "memory_config_path": ".maestro/memory_config.yaml"
    },
    "features": {
      "critical_think": {
        "enabled": true,
        "integration_points": 8,
        "framework": "6-step metacognitive analysis",
        "description": "Native Claude Code integration for systematic analysis and quality assurance"
      },
      "memory_system": {
        "name": "Nexus Memory",
        "features": [
          "Agent-type categorization",
          "Semantic search",
          "Automatic project detection",
          "LLM-enhanced context retrieval",
          "Web dashboard UI"
        ]
      },
      "testing": {
