        "features": [
          "Spec-driven development workflow",
          "Automatic agent selection based on task complexity",
          "TDD enforcement with 80%+ coverage goals",
          "Built-in Nexus Memory system for project context",
          "Critical Think metacognitive analysis framework",
          "Git-aware tracking with rollback capability",
          "Web dashboard for memory and project visualization",
          "Session management with TUI interface"
        ]
      },
      "opencode": {
        "supported": true,
        "min_version": "1.0.0",
        "install_command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/master/install-opencode.sh | bash",
        "commands": [
          {
            "name": "maestro setup",
            "description": "Initialize Maestro for new/existing projects"
          },
          {
            "name": "maestro newTrack",
            "description": "Create new track with interactive spec generation"
          },
          {
            "name": "maestro implement",
            "description": "Execute implementation plan for a track"
          },
          {
            "name": "maestro status",
            "description": "Display progress across all tracks"
          },
          {
            "name": "maestro revert",
            "description": "Revert previous work at specified granularity"
          }
        ],
        "features": [
          "Same workflow engine as Claude Code version",
          "Spec-driven development with automatic planning",
          "Agent selection and task orchestration",
          "Integrated memory system",
          "TDD enforcement with coverage tracking"
        ]
      }
