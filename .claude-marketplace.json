{
  "marketplace_version": "1.0.0",
  "plugin": {
    "id": "maestro",
    "name": "Maestro",
    "displayName": "Maestro - Unified Development Framework",
    "tagline": "Spec-driven development with automatic agent selection and TDD enforcement",
    "description": "Unified spec-driven development framework with track-based development, automatic agent selection, TDD enforcement, integrated memory system, and Critical Think metacognitive analysis.",
    "version": "2.0.0",
    "author": {
      "name": "scooter-lacroix",
      "url": "https://github.com/scooter-lacroix"
    },
    "repository": {
      "type": "git",
      "url": "https://github.com/scooter-lacroix/Maestro"
    },
    "license": "MIT",
    "homepage": "https://github.com/scooter-lacroix/Maestro#readme",
    "documentation": "https://github.com/scooter-lacroix/Maestro/blob/main/docs",
    "bugs": "https://github.com/scooter-lacroix/Maestro/issues",
    "keywords": [
      "development",
      "framework",
      "spec-driven",
      "tdd",
      "testing",
      "agent",
      "memory",
      "critical-thinking",
      "workflow",
      "productivity",
      "cli",
      "automation"
    ],
    "categories": [
      "Development",
      "Testing",
      "Workflow",
      "Productivity"
    ],
    "platforms": {
      "claude_code": {
        "supported": true,
        "min_version": "1.0.0",
        "install_command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/main/install-claude-code.sh | bash",
        "commands": [
          {
            "name": "maestro:setup",
            "description": "Initialize Maestro for new/existing projects"
          },
          {
            "name": "maestro:newTrack",
            "description": "Create new track with interactive spec generation"
          },
          {
            "name": "maestro:implement",
            "description": "Execute implementation plan for a track"
          },
          {
            "name": "maestro:status",
            "description": "Display progress across all tracks"
          },
          {
            "name": "maestro:revert",
            "description": "Revert previous work at specified granularity"
          },
          {
            "name": "maestro:configure",
            "description": "Configure Maestro settings"
          },
          {
            "name": "maestro:tui",
            "description": "Launch Terminal User Interface for session management"
          }
        ],
        "features": [
          "Spec-driven development workflow",
          "Automatic agent selection based on task complexity",
          "TDD enforcement with 80%+ coverage goals",
          "Built-in Nexus Memory system for project context",
          "Critical Think metacognitive analysis framework",
          "Git-aware tracking with rollback capability",
          "Web dashboard for memory and project visualization",
          "Session management with TUI interface"
        ]
      },
      "opencode": {
        "supported": true,
        "min_version": "1.0.0",
        "install_command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/main/install-opencode.sh | bash",
        "commands": [
          {
            "name": "maestro setup",
            "description": "Initialize Maestro for new/existing projects"
          },
          {
            "name": "maestro newTrack",
            "description": "Create new track with interactive spec generation"
          },
          {
            "name": "maestro implement",
            "description": "Execute implementation plan for a track"
          },
          {
            "name": "maestro status",
            "description": "Display progress across all tracks"
          },
          {
            "name": "maestro revert",
            "description": "Revert previous work at specified granularity"
          }
        ],
        "features": [
          "Same workflow engine as Claude Code version",
          "Spec-driven development with automatic planning",
          "Agent selection and task orchestration",
          "Integrated memory system",
          "TDD enforcement with coverage tracking"
        ]
      }
    },
    "dependencies": {
      "python": ">=3.10",
      "required_packages": [
        "click>=8.0.0",
        "pydantic>=2.0.0",
        "toml>=0.10.2",
        "pyyaml>=6.0",
        "rich>=13.0.0"
      ],
      "optional_packages": [
        "sentence-transformers",
        "numpy"
      ]
    },
    "installation": {
      "marketplace": {
        "add": "/plugin marketplace add scooterlacroix/maestro",
        "install": "/plugin install maestro"
      },
      "manual": {
        "url": "https://raw.githubusercontent.com/scooter-lacroix/Maestro/main/install-claude-code.sh",
        "command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/main/install-claude-code.sh | bash"
      }
    },
    "configuration": {
      "global_config_path": "~/.claude/maestro.local.md",
      "project_config_path": ".maestro/config.yaml",
      "memory_config_path": ".maestro/memory_config.yaml"
    },
    "features": {
      "critical_think": {
        "enabled": true,
        "integration_points": 8,
        "framework": "6-step metacognitive analysis",
        "description": "Native Claude Code integration for systematic analysis and quality assurance"
      },
      "memory_system": {
        "name": "Nexus Memory",
        "features": [
          "Agent-type categorization",
          "Semantic search",
          "Automatic project detection",
          "LLM-enhanced context retrieval",
          "Web dashboard UI"
        ]
      },
      "testing": {
        "framework": "pytest",
        "coverage_target": "80%",
        "current_coverage": "237 passing tests"
      }
    },
    "changelog": {
      "current": "2.0.0",
      "latest": "https://github.com/scooter-lacroix/Maestro/blob/main/CHANGELOG.md"
    },
    "screenshots": [
      {
        "url": "https://github.com/scooter-lacroix/Maestro/raw/main/brain.jpeg",
        "description": "Maestro Framework Overview",
        "type": "image"
      },
      {
        "url": "https://github.com/scooter-lacroix/Maestro/raw/main/memory.png",
        "description": "Nexus Memory Dashboard",
        "type": "image"
      }
    ],
    "links": {
      "quick_start": "https://github.com/scooter-lacroix/Maestro#quick-start",
      "documentation": "https://github.com/scooter-lacroix/Maestro/blob/main/docs",
      "examples": "https://github.com/scooter-lacroix/Maestro#examples",
      "support": "https://github.com/scooter-lacroix/Maestro/issues"
    }
  },
  "submission": {
    "submitted_by": "scooter-lacroix",
    "submitted_date": "2026-01-04",
    "status": "ready",
    "review_status": "pending",
    "marketplace_listing": true
  }
}
