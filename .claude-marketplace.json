        "supported": true,
        "min_version": "1.0.0",
        "install_command": "curl -sSL https://raw.githubusercontent.com/scooter-lacroix/Maestro/master/install-claude-code.sh | bash",
        "commands": [
          {
            "name": "maestro:setup",
            "description": "Initialize Maestro for new/existing projects"
          },
          {
            "name": "maestro:newTrack",
            "description": "Create new track with interactive spec generation"
          },
          {
            "name": "maestro:implement",
            "description": "Execute implementation plan for a track"
          },
          {
            "name": "maestro:status",
            "description": "Display progress across all tracks"
          },
          {
            "name": "maestro:revert",
            "description": "Revert previous work at specified granularity"
          },
          {
            "name": "maestro:configure",
            "description": "Configure Maestro settings"
          },
          {
            "name": "maestro:tui",
            "description": "Launch Terminal User Interface for session management"
          },
          {
            "name": "maestro:leindex",
            "description": "Run LeIndex code analysis and search"
          },
          {
            "name": "maestro:memory",
            "description": "Manage Nexus Memory system and context"
          },
          {
            "name": "maestro:orchestrate",
            "description": "Run conductor orchestration loop"
          },
          {
            "name": "maestro:tldr",
            "description": "Summarize code with TLDR analysis"
          }
        ],
        "hooks": [
          {
            "name": "session-start/session-load",
            "description": "Load session context and project state",
            "phase": "session-start"
          },
          {
            "name": "session-start/session-register",
            "description": "Register session with memory system",
            "phase": "session-start"
          },
          {
            "name": "session-start/trace-start",
            "description": "Start agent flow trace",
            "phase": "session-start"
          },
          {
            "name": "pre-tool-use/tldr-read",
            "description": "Pre-tool TLDR context injection",
            "phase": "pre-tool-use"
          },
          {
            "name": "pre-tool-use/smart-search",
            "description": "Smart code search before tool use",
            "phase": "pre-tool-use"
          },
          {
            "name": "pre-tool-use/file-claims",
            "description": "Track file ownership claims",
            "phase": "pre-tool-use"
          },
          {
            "name": "pre-tool-use/tldr-context",
            "description": "TLDR context enrichment",
            "phase": "pre-tool-use"
          },
          {
            "name": "post-tool-use/post-edit",
            "description": "Post-edit file processing",
            "phase": "post-tool-use"
          },
          {
            "name": "post-tool-use/handoff-index",
            "description": "Index handoffs to memory",
            "phase": "post-tool-use"
          },
          {
            "name": "post-tool-use/edit-notify",
            "description": "Notify on file edits",
            "phase": "post-tool-use"
          },
          {
            "name": "pre-compact/continuity",
            "description": "Maintain context continuity before compaction",
            "phase": "pre-compact"
          },
          {
            "name": "user-prompt-submit/skill-activation",
            "description": "Activate relevant skills on prompt",
            "phase": "user-prompt-submit"
          },
          {
            "name": "user-prompt-submit/memory-recall",
            "description": "Recall relevant memories on prompt",
            "phase": "user-prompt-submit"
          },
          {
            "name": "subagent-stop/agent-report",
            "description": "Process subagent completion report",
            "phase": "subagent-stop"
          },
          {
            "name": "session-end/session-cleanup",
            "description": "Cleanup session resources",
            "phase": "session-end"
          },
          {
            "name": "session-end/session-outcome",
            "description": "Record session outcome to memory",
            "phase": "session-end"
          }
