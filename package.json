{
  "name": "maestro-tracklens",
  "version": "1.0.0",
  "description": "Maestro TrackLens - Code review and annotation system",
  "workspaces": [
    "packages/*",
    "apps/tracklens-*"
  ],
  "scripts": {
    "build": "bun run build:deps && bun run build:editor && bun run build:review-editor && bun run build:apps",
    "build:tracklens": "bun run build",
    "build:deps": "bun run build:shared && bun run build:web-highlighter && bun run build:ui && bun run build:server",
    "build:shared": "bun run --cwd packages/tracklens-shared build",
    "build:web-highlighter": "bun run --cwd packages/tracklens-web-highlighter build",
    "build:ui": "bun run --cwd packages/tracklens-ui build",
    "build:server": "bun run --cwd packages/tracklens-server build",
    "build:editor": "bun run --cwd packages/tracklens-editor build",
    "build:review-editor": "bun run --cwd packages/tracklens-review-editor build",
    "build:apps": "bun run build:hook && bun run build:opencode",
    "build:hook": "bun run --cwd apps/tracklens-hook build",
    "build:opencode": "bun run --cwd apps/tracklens-opencode build",
    "dev": "bun run build:deps && concurrently \"bun run dev:editor\" \"bun run dev:review-editor\"",
    "dev:editor": "bun run --cwd packages/tracklens-editor dev",
    "dev:review-editor": "bun run --cwd packages/tracklens-review-editor dev",
    "dev:ui": "bun run --cwd packages/tracklens-ui dev",
    "dev:server": "bun run --cwd packages/tracklens-server dev",
    "watch": "concurrently \"bun run watch:shared\" \"bun run watch:ui\" \"bun run watch:server\"",
    "watch:shared": "bun run --cwd packages/tracklens-shared dev",
    "watch:ui": "bun run --cwd packages/tracklens-ui dev",
    "watch:server": "bun run --cwd packages/tracklens-server dev",
    "clean": "rm -rf packages/*/dist apps/tracklens-opencode/tracklens.html apps/tracklens-opencode/tracklens-review.html",
    "install:all": "bun install"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "bun-types": "^1.3.10",
    "concurrently": "^8.2.0",
    "typescript": "^5.9.3"
  }
}
