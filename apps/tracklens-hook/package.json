{
  "name": "@maestro/tracklens-hook",
  "version": "0.1.0",
  "description": "TrackLens Claude Code integration - visual review, annotation, and walkthrough system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && bun build:ui",
    "build:ui": "cd ../tracklens-editor && bun run build && cd ../tracklens-review-editor && bun run build",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "maestro",
    "tracklens",
    "claude-code",
    "code-review",
    "annotation"
  ],
  "author": "Maestro",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@maestro/tracklens-server": "workspace:*",
    "@maestro/tracklens-editor": "workspace:*",
    "@maestro/tracklens-review-editor": "workspace:*"
  },
  "type": "module"
}
