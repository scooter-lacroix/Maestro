{
  "name": "maestro",
  "version": "1.4.0",
  "description": "Spec-driven development framework with rigorous agent review, TDD workflow, and project tracking. Features proactive agent usage, automated agent configuration, and comprehensive code style guides.",
  "author": "scooter-lacroix",
  "license": "MIT",
  "homepage": "https://github.com/scooter-lacroix/Maestro",
  "repository": {
    "type": "git",
    "url": "https://github.com/scooter-lacroix/Maestro.git"
  },
  "keywords": [
    "tdd",
    "workflow",
    "agent-review",
    "spec-driven",
    "project-management",
    "development-framework",
    "proactive-agents",
    "multi-agent",
    "opencode",
    "maestro"
  ],
  "dependencies": {
    "nexus-memory": ">=1.0.0"
  },
  "claude": {
    "minVersion": "2.0.0",
    "maxVersion": "3.0.0"
  },
  "commands": [
    "maestro:setup",
    "maestro:newTrack",
    "maestro:implement",
    "maestro:status",
    "maestro:revert",
    "maestro:configure",
    "maestro:memory",
    "maestro:tui",
    "maestro:leindex",
    "maestro:orchestrate",
    "maestro:tldr"
  ],
  "hooks": {
    "path": "maestro/hooks",
    "phases": [
      "session-start",
      "pre-tool-use",
      "post-tool-use",
      "pre-compact",
      "user-prompt-submit",
      "subagent-stop",
      "session-end"
    ]
  },
  "skills": {
    "path": "maestro/skills",
    "categories": [
      "meta",
      "workflows",
      "context",
      "analysis",
      "research",
      "quality",
      "planning"
    ]
  },
  "templates": [
    "workflow",
    "code_styleguides/general",
    "code_styleguides/angular",
    "code_styleguides/c",
    "code_styleguides/cpp",
    "code_styleguides/csharp",
    "code_styleguides/dart",
    "code_styleguides/docker",
    "code_styleguides/go",
    "code_styleguides/graphql",
    "code_styleguides/html-css",
    "code_styleguides/java",
    "code_styleguides/javascript",
    "code_styleguides/kotlin",
    "code_styleguides/nextjs",
    "code_styleguides/nodejs",
    "code_styleguides/php",
    "code_styleguides/python",
    "code_styleguides/react",
    "code_styleguides/ruby",
    "code_styleguides/rust",
    "code_styleguides/shell",
    "code_styleguides/sql",
    "code_styleguides/svelte",
    "code_styleguides/swift",
    "code_styleguides/threejs",
    "code_styleguides/typescript",
    "code_styleguides/vue"
  ],
  "features": [
    "Proactive automatic agent usage",
    "Automated agent creation via /maestro:configure",
    "Comprehensive code style guides (27 templates across languages and frameworks)",
    "Exhaustive agent support (10+ agents)",
    "Fallback for missing CLI tools",
    "TDD workflow enforcement",
    "Git-aware project tracking",
    "OpenCode integration support"
  ],
  "updateUrl": "https://github.com/scooter-lacroix/Maestro/releases/latest",
  "changelog": "https://github.com/scooter-lacroix/Maestro/blob/master/CHANGELOG.md"
}
