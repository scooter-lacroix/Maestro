{
  "name": "@maestro/tracklens-server",
  "version": "0.1.0",
  "description": "TrackLens server utilities - Node.js HTTP servers for review and annotation modes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./annotate": {
      "types": "./dist/annotate.d.ts",
      "default": "./dist/annotate.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "maestro",
    "tracklens",
    "server",
    "http-server"
  ],
  "author": "Maestro",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@maestro/tracklens-shared": "workspace:*"
  },
  "type": "module"
}
